N = 8

def print_board(board):
    for row in board:
        print(" ".join(row))

def is_safe(board, row, col):
    # Check column
    for i in range(row):
        if board[i][col] == "Q":
            return False

    # Check left diagonal
    i, j = row, col
    while i >= 0 and j >= 0:
        if board[i][j] == "Q":
            return False
        i -= 1
        j -= 1

    # Check right diagonal
    i, j = row, col
    while i >= 0 and j < N:
        if board[i][j] == "Q":
            return False
        i -= 1
        j += 1

    return True

def solve(board, row):
    if row == N:
        print("Solution Found:\n")
        print_board(board)
        return True

    for col in range(N):
        if is_safe(board, row, col):
            board[row][col] = "Q"

            if solve(board, row + 1):
                return True

            board[row][col] = "."

    return False

board = [["." for _ in range(N)] for _ in range(N)]

if not solve(board, 0):
    print("No Solution Exists")

