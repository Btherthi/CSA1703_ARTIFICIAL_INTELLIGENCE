from collections import deque
def bfs(graph, start):
visited = set()
queue = deque([start])
visited. Add(start)
print("BFS Traversal:")
while queue:
node = queue.popleft()
 print(node, end=" ")
for neighbor in graph[node]:
if neighbor not in visited:
 visited. Add(neighbor)
queue. Append(neighbor)
graph = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F'],
    'D': [],
    'E': ['F'],
    'F': []
}

start = input("Enter the starting node: ")

bfs(graph, start)

